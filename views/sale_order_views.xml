<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_order_form_inherit_dimensions" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.dimensions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Grilla de líneas -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom']" position="after">
                <field name="x_espesor" string="Espesor" optional="show"/>
                <field name="x_ancho" string="Ancho" optional="show"/>
                <field name="x_alto" string="Alto" optional="show"/>
            </xpath>

            <!-- Formulario interno de la línea -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom']" position="after">
                <field name="x_espesor"/>
                <field name="x_ancho"/>
                <field name="x_alto"/>
            </xpath>

        </field>
    </record>

</odoo>